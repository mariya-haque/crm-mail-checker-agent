# OpenAI API key, read automatically by the OpenAI Agents SDK.
OPENAI_API_KEY=

# --- CRM mail API (see README for where to find each value) ---
CRM_API_BASE=https://api.your-crm.com/api/v1/mail
CRM_ACCOUNT_ID=
CRM_INBOX_FOLDER_ID=
# Value of the better-auth.session_token cookie. It expires; refresh it when you get 401s.
CRM_SESSION_TOKEN=
# Optional Referer header, e.g. https://your-crm.com/mail
CRM_REFERER=
